{
  "name": "generative-ensemble",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolation": "node scripts/test-isolation.mjs",
    "test:e2e": "playwright test",
    "verify:samples": "node scripts/verify-samples.mjs",
    "verify:m1": "node scripts/verify-m1.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format:check": "prettier --check src tests scripts docs plan.md README.md CURRENT_STATE.md package.json package-lock.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js index.html",
    "verify:m2": "node scripts/verify-m1.mjs --m2",
    "export:violin-ab": "node --experimental-strip-types scripts/export-violin-ab.mjs"
  },
  "dependencies": {
    "@tonaljs/tonal": "4.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
